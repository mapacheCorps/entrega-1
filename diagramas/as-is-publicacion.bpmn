      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="es_di" bpmnElement="es">
        <dc:Bounds x="650" y="118" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ee_di" bpmnElement="ee">
        <dc:Bounds x="930" y="140" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="885" y="184" width="126" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="146" y="158" />
        <di:waypoint x="210" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="370" y="158" />
        <di:waypoint x="430" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="590" y="158" />
        <di:waypoint x="650" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="810" y="158" />
        <di:waypoint x="930" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Pool_C_di" bpmnElement="Pool_C" isHorizontal="true">
        <dc:Bounds x="40" y="360" width="1420" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_C_di" bpmnElement="Lane_C" isHorizontal="true">
        <dc:Bounds x="70" y="360" width="1390" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c0_di" bpmnElement="c0">
        <dc:Bounds x="712" y="440" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="667" y="484" width="126" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c1_di" bpmnElement="c1">
        <dc:Bounds x="850" y="418" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ce_di" bpmnElement="ce">
        <dc:Bounds x="1160" y="440" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1115" y="484" width="126" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="748" y="458" />
        <di:waypoint x="850" y="458" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1010" y="458" />
        <di:waypoint x="1160" y="458" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Message_7_di" bpmnElement="Message_7">
        <di:waypoint x="730" y="198" />
        <di:waypoint x="730" y="440" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="750" y="280" width="120" height="32" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
