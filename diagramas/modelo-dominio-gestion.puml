@startuml
!theme plain
skinparam shadowing false
skinparam classAttributeIconSize 0
hide methods
hide circle
title MODELO DE DOMINIO UML  |  2. GESTION Y SEGUIMIENTO

class Estudiante {
  identificador: texto
  nombre: texto
  correo: texto
}

class ComunidadEstudiantil {
  identificador: texto
  nombre: texto
}

class Aporte {
  identificador: texto
  fechaEnvio: fecha
  procedenciaDeclarada: texto
  estado: texto
}

class VersionApunte {
  numero: entero
  nombreArchivo: texto
  referenciaArchivo: texto
  estado: texto
}

class AsignacionRevision {
  identificador: texto
  fechaAsignacion: fecha
  estado: texto
}

class Notificacion {
  identificador: texto
  contenido: texto
  estadoEntrega: texto
}

class ReporteError {
  identificador: texto
  descripcion: texto
  estado: texto
}

ComunidadEstudiantil "1" -- "0..*" AsignacionRevision : organiza
AsignacionRevision "0..*" -- "1" Aporte : se refiere a
Estudiante "1" -- "0..*" AsignacionRevision : asume
VersionApunte "1" -- "0..*" Notificacion : origina
Estudiante "1" -- "0..*" Notificacion : recibe
VersionApunte "1" -- "0..*" ReporteError : recibe
Estudiante "1" -- "0..*" ReporteError : informa
@enduml
