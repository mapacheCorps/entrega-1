<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="https://torpedos.example/bpmn" exporter="bpmn-js (https://bpmn.io)" exporterVersion="18.9.1">
  <bpmn:collaboration id="Collaboration_1" name="AS-IS · Buscar y obtener apuntes (hipótesis por validar)">
    <bpmn:participant id="Pool_E" name="Estudiante" processRef="Process_E" />
    <bpmn:participant id="Pool_C" name="Comunidad estudiantil" processRef="Process_C" />
    <bpmn:messageFlow id="Message_13" name="Solicitud" sourceRef="ask" targetRef="c0" />
    <bpmn:messageFlow id="Message_14" name="Archivo o respuesta" sourceRef="respond" targetRef="recv" />
  </bpmn:collaboration>
  <bpmn:process id="Process_E" isExecutable="false">
    <bpmn:documentation>HIPÓTESIS POR VALIDAR: se propone reconstruir con estudiantes la búsqueda en chats, la consulta a la comunidad y la respuesta. No hay tiempos observados ni garantía de revisión académica. Este diagrama no afirma que la comunidad responda siempre.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_E">
      <bpmn:lane id="Lane_E" name="Estudiante que consulta">
        <bpmn:flowNodeRef>e0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>search</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>avail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prep</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="e0" name="Necesita material">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="search" name="A06 · Buscar en chats y archivos disponibles">
      <bpmn:incoming>Flow_prep</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="found" name="¿Encuentra material pertinente?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ask" name="A07 · Solicitar apunte a la comunidad">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="recv" name="A08 · Recibir respuesta">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="avail" name="¿Recibió material útil?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="save" name="A09 · Guardar apunte encontrado">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ok" name="Apunte obtenido sin revisión formal acreditada">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="no" name="Búsqueda sin resultado">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="e0" targetRef="prep" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="search" targetRef="found" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="ask" targetRef="recv" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="recv" targetRef="avail" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="save" targetRef="ok" />
    <bpmn:sequenceFlow id="Flow_9" name="Sí" sourceRef="found" targetRef="save" />
    <bpmn:sequenceFlow id="Flow_10" name="No" sourceRef="found" targetRef="ask" />
    <bpmn:sequenceFlow id="Flow_11" name="Sí" sourceRef="avail" targetRef="save" />
    <bpmn:sequenceFlow id="Flow_12" name="No" sourceRef="avail" targetRef="no" />
    <bpmn:manualTask id="prep" name="A05 · Definir materia y unidad que necesita repasar">
      <bpmn:documentation>Actividad cognitiva sin apoyo de un sistema. Paso propuesto para explicitar el objetivo de la búsqueda; confirmar con el participante.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_prep</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="Flow_prep" sourceRef="prep" targetRef="search" />
  </bpmn:process>
  <bpmn:process id="Process_C" isExecutable="false">
    <bpmn:documentation>HIPÓTESIS POR VALIDAR: se propone reconstruir con estudiantes la búsqueda en chats, la consulta a la comunidad y la respuesta. No hay tiempos observados ni garantía de revisión académica. Este diagrama no afirma que la comunidad responda siempre.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_C">
      <bpmn:lane id="Lane_C" name="Gestión comunitaria actual">
        <bpmn:flowNodeRef>c0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>locate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>respond</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ce</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c0" name="Solicitud recibida">
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c0_message" />
    </bpmn:startEvent>
    <bpmn:userTask id="locate" name="A10 · Buscar material y comprobar disponibilidad">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="respond" name="A11 · Enviar archivo disponible o informar ausencia">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ce" name="Consulta atendida">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="c0" targetRef="locate" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="locate" targetRef="respond" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="respond" targetRef="ce" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1" name="AS-IS · Buscar y obtener apuntes (hipótesis por validar)">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Pool_E_di" bpmnElement="Pool_E" isHorizontal="true">
