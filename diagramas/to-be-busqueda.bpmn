<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="https://torpedos.example/bpmn" exporter="bpmn-js (https://bpmn.io)" exporterVersion="18.9.1">
  <bpmn:collaboration id="Collaboration_1" name="TO-BE · Buscar, evaluar y obtener apuntes">
    <bpmn:participant id="Pool_E" name="Estudiante" processRef="Process_E" />
    <bpmn:participant id="Pool_C" name="Comunidad estudiantil" processRef="Process_C" />
    <bpmn:messageFlow id="Message_20" name="Filtros" sourceRef="send" targetRef="c0" />
    <bpmn:messageFlow id="Message_21" name="Resultados" sourceRef="reply" targetRef="results" />
    <bpmn:messageFlow id="Message_22" name="Identificador y versión" sourceRef="download" targetRef="d0" />
    <bpmn:messageFlow id="Message_23" name="Archivo o aviso" sourceRef="sendfile" targetRef="file" />
  </bpmn:collaboration>
  <bpmn:process id="Process_E" isExecutable="false">
    <bpmn:documentation>Propuesta. Dos inicios por mensaje en Comunidad atienden operaciones independientes: búsqueda y descarga. Cada respuesta se vincula a su solicitud. Solo el material publicado se ofrece en resultados. La ficha muestra procedencia, período, versión, alcance y fecha de revisión. Se contempla ausencia de resultados y archivo retirado o no disponible.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_E">
      <bpmn:lane id="Lane_E" name="Estudiante que consulta">
        <bpmn:flowNodeRef>e0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>filters</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>results</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>download</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>file</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>prep</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="e0" name="Necesita material">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="filters" name="B01 · Indicar ramo, carrera, período y tema">
      <bpmn:incoming>Flow_prep</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="send" name="B02 · Solicitar búsqueda">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="results" name="B10 · Recibir resultados y fichas">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="found" name="¿Hay material pertinente?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="inspect" name="B05 · Consultar procedencia, versión y revisión">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="download" name="B06 · Solicitar descarga del apunte elegido">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="file" name="B09 · Recibir archivo o aviso de indisponibilidad">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="available" name="¿Archivo disponible?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ok" name="Apunte obtenido">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="retry" name="¿Cambiar búsqueda?">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="no" name="Sin material adecuado">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="e0" targetRef="prep" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="filters" targetRef="send" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="send" targetRef="results" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="results" targetRef="found" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="inspect" targetRef="download" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="download" targetRef="file" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="file" targetRef="available" />
    <bpmn:sequenceFlow id="Flow_14" name="Sí" sourceRef="found" targetRef="inspect" />
    <bpmn:sequenceFlow id="Flow_15" name="No" sourceRef="found" targetRef="retry" />
    <bpmn:sequenceFlow id="Flow_16" name="Sí" sourceRef="available" targetRef="ok" />
    <bpmn:sequenceFlow id="Flow_17" name="No" sourceRef="available" targetRef="retry" />
    <bpmn:sequenceFlow id="Flow_18" name="Sí" sourceRef="retry" targetRef="filters" />
    <bpmn:sequenceFlow id="Flow_19" name="No" sourceRef="retry" targetRef="no" />
    <bpmn:manualTask id="prep" name="B00 · Definir materia y unidad que necesita repasar">
      <bpmn:documentation>Actividad cognitiva sin apoyo de un sistema. Paso propuesto para explicitar el objetivo de la búsqueda; confirmar con el participante.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_prep</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sequenceFlow id="Flow_prep" sourceRef="prep" targetRef="filters" />
  </bpmn:process>
  <bpmn:process id="Process_C" isExecutable="false">
    <bpmn:documentation>Propuesta. Dos inicios por mensaje en Comunidad atienden operaciones independientes: búsqueda y descarga. Cada respuesta se vincula a su solicitud. Solo el material publicado se ofrece en resultados. La ficha muestra procedencia, período, versión, alcance y fecha de revisión. Se contempla ausencia de resultados y archivo retirado o no disponible.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_C">
      <bpmn:lane id="Lane_C" name="Administración y operación de la plataforma">
        <bpmn:flowNodeRef>c0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>query</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>serve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendfile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>de</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c0" name="Consulta recibida">
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c0_message" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="query" name="B03 · Buscar apuntes publicados y sus revisiones">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="reply" name="B04 · Devolver resultados y fichas">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ce" name="Consulta respondida">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="d0" name="Descarga solicitada">
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:messageEventDefinition id="d0_message" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="serve" name="B07 · Verificar disponibilidad y preparar respuesta">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="sendfile" name="B08 · Entregar archivo o informar indisponibilidad">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="de" name="Descarga atendida">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="c0" targetRef="query" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="query" targetRef="reply" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="reply" targetRef="ce" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="d0" targetRef="serve" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="serve" targetRef="sendfile" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="sendfile" targetRef="de" />
  </bpmn:process>
