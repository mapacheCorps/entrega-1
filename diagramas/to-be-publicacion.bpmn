<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="https://torpedos.example/bpmn" exporter="bpmn-js (https://bpmn.io)" exporterVersion="18.9.1">
  <bpmn:collaboration id="Collaboration_1" name="TO-BE · Recibir, revisar y publicar apuntes">
    <bpmn:participant id="Pool_E" name="Estudiante" processRef="Process_E" />
    <bpmn:participant id="Pool_C" name="Comunidad estudiantil" processRef="Process_C" />
    <bpmn:messageFlow id="Message_28" name="Aporte y datos" sourceRef="es" targetRef="c0" />
    <bpmn:messageFlow id="Message_29" name="Observaciones" sourceRef="request" targetRef="fixmsg" />
    <bpmn:messageFlow id="Message_30" name="Nueva versión" sourceRef="resend" targetRef="corrected" />
    <bpmn:messageFlow id="Message_31" name="Resultado" sourceRef="notify" targetRef="result" />
  </bpmn:collaboration>
  <bpmn:process id="Process_E" isExecutable="false">
    <bpmn:documentation>Propuesta de mejora. El aporte conserva un identificador e historial de versiones. Período académico y nivel de carrera son datos distintos. La revisión registra alcance, revisor, fecha y versión. Solo se publica contenido aprobado. Recordatorio de 48 horas ilustrativo por validar. El envío de correcciones mantiene el mismo caso. Las decisiones del moderador requieren criterios acordados.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_E">
      <bpmn:lane id="Lane_E" name="Autor del aporte">
        <bpmn:flowNodeRef>e0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>es</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fixmsg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ee</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="e0" name="Necesidad de compartir">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="e1" name="P01 · Adjuntar archivo y declarar procedencia">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="e2" name="P02 · Indicar carrera, ramo, período y tema">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="es" name="P03 · Enviar aporte">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:eventBasedGateway id="wait" name="Esperar respuesta">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="fixmsg" name="Correcciones solicitadas">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="fixmsg_message" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="fix" name="P13 · Corregir archivo o datos">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="resend" name="P14 · Enviar versión corregida">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="result" name="Resultado final recibido">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="result_message" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="ee" name="Resultado conocido">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="e0" targetRef="e1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="e1" targetRef="e2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="e2" targetRef="es" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="es" targetRef="wait" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="fixmsg" targetRef="fix" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="fix" targetRef="resend" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="result" targetRef="ee" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="wait" targetRef="fixmsg" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="wait" targetRef="result" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="resend" targetRef="wait" />
  </bpmn:process>
  <bpmn:process id="Process_C" isExecutable="false">
    <bpmn:documentation>Propuesta de mejora. El aporte conserva un identificador e historial de versiones. Período académico y nivel de carrera son datos distintos. La revisión registra alcance, revisor, fecha y versión. Solo se publica contenido aprobado. Recordatorio de 48 horas ilustrativo por validar. El envío de correcciones mantiene el mismo caso. Las decisiones del moderador requieren criterios acordados.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_C">
      <bpmn:lane id="Lane_C" name="Administración y operación de la plataforma">
        <bpmn:flowNodeRef>c0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>assign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ce</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>corrected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>re</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timer</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c0" name="Aporte recibido">
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c0_message" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="check" name="P04 · Validar archivo, datos y duplicados exactos">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="valid" name="¿Entrada válida?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="assign" name="P05 · Asignar ayudante competente y disponible">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="review" name="P06 · Revisar contenido y registrar evidencia">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="decision" name="Resultado de revisión">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="publish" name="P09 · Publicar versión aprobada y su revisión">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="reject" name="P10 · Registrar rechazo fundamentado">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="merge" name="">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="notify" name="P11 · Notificar resultado y enlace o motivo">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ce" name="Caso resuelto">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="request" name="P07 · Solicitar correcciones consolidadas">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="corrected" name="P08 · Recibir nueva versión del mismo aporte">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="remind" name="P12 · Recordar al ayudante y alertar coordinación">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="re" name="Seguimiento registrado">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="timer" name="48 h sin resolución" cancelActivity="false" attachedToRef="review">
      <bpmn:documentation>Plazo ilustrativo de 48 horas; debe acordarse con la comunidad. Recordatorio no interruptivo: la revisión continúa.</bpmn:documentation>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
      <bpmn:timerEventDefinition id="timer_timer">
        <bpmn:timeDuration>PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="c0" targetRef="check" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="check" targetRef="valid" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="assign" targetRef="review" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="review" targetRef="decision" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="merge" targetRef="notify" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="notify" targetRef="ce" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="request" targetRef="corrected" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="remind" targetRef="re" />
    <bpmn:sequenceFlow id="Flow_19" name="Sí" sourceRef="valid" targetRef="assign" />
    <bpmn:sequenceFlow id="Flow_20" name="No: corregir" sourceRef="valid" targetRef="request" />
    <bpmn:sequenceFlow id="Flow_21" name="Aprobado" sourceRef="decision" targetRef="publish" />
    <bpmn:sequenceFlow id="Flow_22" name="Rechazado" sourceRef="decision" targetRef="reject" />
    <bpmn:sequenceFlow id="Flow_23" name="Corregible" sourceRef="decision" targetRef="request" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="publish" targetRef="merge" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="reject" targetRef="merge" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="corrected" targetRef="check" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="timer" targetRef="remind" />
  </bpmn:process>
