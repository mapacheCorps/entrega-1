<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="https://torpedos.example/bpmn" exporter="bpmn-js (https://bpmn.io)" exporterVersion="18.9.1">
  <bpmn:collaboration id="Collaboration_1" name="TO-BE · Reportar errores y mantener versiones">
    <bpmn:participant id="Pool_E" name="Estudiante" processRef="Process_E" />
    <bpmn:participant id="Pool_C" name="Comunidad estudiantil" processRef="Process_C" />
    <bpmn:messageFlow id="Message_19" name="Reporte y versión" sourceRef="send" targetRef="c0" />
    <bpmn:messageFlow id="Message_20" name="Resolución" sourceRef="notify" targetRef="receive" />
  </bpmn:collaboration>
  <bpmn:process id="Process_E" isExecutable="false">
    <bpmn:documentation>Propuesta. Cada reporte identifica apunte y versión y registra seguimiento. Un reporte no se considera error confirmado sin revisión. Una nueva versión exige evidencia de revisión y conserva el historial de la anterior. Si el equipo no puede corregir un error confirmado, retira la versión afectada y deja constancia; una contribución del autor se tramita por el proceso de publicación. No se elimina el historial.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_E">
      <bpmn:lane id="Lane_E" name="Estudiante que reporta">
        <bpmn:flowNodeRef>e0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>detail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ee</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="e0" name="Detecta posible error">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="detail" name="E01 · Identificar apunte, versión y explicar el error">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="send" name="E02 · Enviar reporte">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="receive" name="E10 · Recibir resolución y enlace o motivo">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ee" name="Resultado conocido">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="e0" targetRef="detail" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="detail" targetRef="send" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="send" targetRef="receive" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="receive" targetRef="ee" />
  </bpmn:process>
  <bpmn:process id="Process_C" isExecutable="false">
    <bpmn:documentation>Propuesta. Cada reporte identifica apunte y versión y registra seguimiento. Un reporte no se considera error confirmado sin revisión. Una nueva versión exige evidencia de revisión y conserva el historial de la anterior. Si el equipo no puede corregir un error confirmado, retira la versión afectada y deja constancia; una contribución del autor se tramita por el proceso de publicación. No se elimina el historial.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_C">
      <bpmn:lane id="Lane_C" name="Administración y operación de la plataforma">
        <bpmn:flowNodeRef>c0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>dismiss</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>flag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>can</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>withdraw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ce</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="c0" name="Reporte recibido">
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="c0_message" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="register" name="E03 · Registrar caso y asignar revisor competente">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="review" name="E04 · Analizar reporte y contrastar contenido">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="confirmed" name="¿Error confirmado?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="dismiss" name="E11 · Registrar reporte no confirmado y motivo">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="flag" name="E05 · Marcar versión afectada en revisión">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="can" name="¿Equipo puede corregir?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="fix" name="E06 · Crear versión corregida y revisarla">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="publish" name="E07 · Publicar nueva versión con evidencia e historial">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="withdraw" name="E08 · Retirar versión afectada y registrar motivo">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="merge" name="">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="notify" name="E09 · Notificar resolución al estudiante">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ce" name="Reporte resuelto">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="c0" targetRef="register" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="register" targetRef="review" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="review" targetRef="confirmed" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="flag" targetRef="can" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="fix" targetRef="publish" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="merge" targetRef="notify" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="notify" targetRef="ce" />
    <bpmn:sequenceFlow id="Flow_12" name="No" sourceRef="confirmed" targetRef="dismiss" />
    <bpmn:sequenceFlow id="Flow_13" name="Sí" sourceRef="confirmed" targetRef="flag" />
    <bpmn:sequenceFlow id="Flow_14" name="Sí" sourceRef="can" targetRef="fix" />
    <bpmn:sequenceFlow id="Flow_15" name="No" sourceRef="can" targetRef="withdraw" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="publish" targetRef="merge" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="withdraw" targetRef="merge" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="dismiss" targetRef="merge" />
  </bpmn:process>
