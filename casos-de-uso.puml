@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
title Casos de uso: Torpedos universitarios
actor "Estudiante autor" as AUT
actor "Estudiante consultante" as CON
actor "Comunidad estudiantil" as COM
actor "Servicio de almacenamiento\n(propuesto)" as ALM <<sistema externo>>
actor "Servicio de correo\n(propuesto)" as COR <<sistema externo>>
rectangle "Torpedos universitarios" {
 usecase "CU-01\nEnviar y clasificar aporte" as CU01
 usecase "CU-02\nOrganizar revision de aporte" as CU02
 usecase "CU-03\nEvaluar aporte y registrar decision" as CU03
 usecase "CU-04\nReenviar aporte corregido" as CU04
 usecase "CU-05\nConocer resultado y feedback" as CU05
 usecase "CU-06\nBuscar material publicado" as CU06
 usecase "CU-07\nConsultar ficha del apunte" as CU07
 usecase "CU-08\nObtener version del apunte" as CU08
 usecase "CU-09\nReportar posible error" as CU09
 usecase "CU-10\nGestionar revisiones demoradas" as CU10
 usecase "CU-11\nCorregir o retirar version" as CU11
}
AUT -- CU01
AUT -- CU04
AUT -- CU05
CON -- CU06
CON -- CU07
CON -- CU08
CON -- CU09
COM -- CU02
COM -- CU03
COM -- CU10
COM -- CU11
ALM -- CU01
ALM -- CU08
COR -- CU05
@enduml
